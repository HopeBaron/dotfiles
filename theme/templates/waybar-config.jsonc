// GENERATED by theme/render.sh from theme/palette.sh -- do not edit by hand.
// Every command referenced here has a package in ~/dotfiles/packages/.
{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  // The bar is transparent and the three module groups are drawn as floating
  // islands (see style.css), so it needs to sit off the screen edges.
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["hyprland/workspaces"],
  "modules-center": ["clock", "tray"],
  "modules-right":  ["hyprland/language", "cpu", "memory", "pulseaudio", "network",
                     "bluetooth", "custom/caffeine", "custom/notification", "custom/power"],

  // Keyboard layout. Switched with SUPER+space (grp:win_space_toggle).
  "hyprland/language": {
    // {shortDescription} is xkb's short name: us -> "en", ara -> "ar". It is
    // used instead of per-layout "format-<lang>" keys on purpose --
    // on waybar 0.15.0 those keys are never applied, and "format-ar"
    // specifically kills the module outright ("argument not found"), which
    // also makes this work for any layout added later without new keys.
    "format": "\uf11c  {shortDescription}"
  },

  "hyprland/workspaces": {
    // No "on-click" here on purpose. Click-to-switch is non-functional on
    // this system regardless -- this Hyprland build's Lua config rejects
    // the classic `dispatch <name> <args>` IPC syntax waybar's built-in
    // click handler sends (server-side, for any client, not just the CLI).
    // Switching stays keyboard-only (SUPER+1-0). Not a config bug to "fix"
    // here; see memory hyprland-lua-dispatch-breaks-classic-syntax.
    "format": "{name}",
    "sort-by": "number"
  },


  // Seconds, as asked. Tooltip shows the month calendar.
  "clock": {
    "interval": 1,
    // No padding spaces in the format string: two leading spaces and none
    // trailing pushed the text off-centre inside the island. Padding is the
    // stylesheet's job (#clock), where it stays symmetric.
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%a %d %b %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":  "<span color='#${FG0}'><b>{}</b></span>",
        "days":    "<span color='#${FG0}'>{}</span>",
        "weekdays":"<span color='#${YELLOW}'><b>{}</b></span>",
        "today":   "<span color='#${ORANGE}'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu":    { "interval": 2, "format": "  {usage}%", "tooltip": true },
  "memory": { "interval": 5, "format": "  {percentage}%",
              "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎",
                      "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-linked": "󰈀  no IP",
    "format-disconnected": "󰖪  offline",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    // nmtui in kitty, so it inherits the Gruvbox Material terminal colours.
    "on-click": "kitty --class net-tui -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯  {status}",
    "format-connected": "󰂱  {device_alias}",
    "format-disabled": "󰂲",
    // This machine has no controller; hide the module rather than show a dead icon.
    "format-no-controller": "",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚", "none": "󰂜",
      "dnd-notification": "󰂛", "dnd-none": "󰂛",
      "inhibited-notification": "󰂚", "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // Coffee-cup keep-awake toggle. Also bound to SUPER+SHIFT+`. "signal": 8
  // matches caffeine.sh's `pkill -RTMIN+8 waybar`, so the icon updates the
  // instant either trigger fires instead of waiting for the next interval.
  "custom/caffeine": {
    "format": "",
    "tooltip": true,
    "return-type": "json",
    "exec": "$HOME/.config/hypr/scripts/caffeine.sh status",
    "on-click": "$HOME/.config/hypr/scripts/caffeine.sh toggle",
    "interval": 30,
    "signal": 8
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "$HOME/.config/hypr/scripts/rofi-power.sh"
  }
}
