// GENERATED by theme/render.sh -- do not edit by hand. Edit theme/templates/.
// Every command referenced here has a package in ~/dotfiles/packages/.
{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  // The bar is transparent and the three module groups are drawn as floating
  // islands (see style.css), so it needs to sit off the screen edges.
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
                     "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10",
                     "custom/ws-events"],
  "modules-center": ["clock", "tray"],
  "modules-right":  ["hyprland/language", "cpu", "memory", "pulseaudio", "network",
                     "bluetooth", "custom/caffeine", "custom/notification", "custom/power"],

  // Keyboard layout. Switched with SUPER+space (grp:win_space_toggle).
  "hyprland/language": {
    // {shortDescription} is xkb's short name: us -> "en", ara -> "ar". It is
    // used instead of per-layout "format-<lang>" keys on purpose --
    // on waybar 0.15.0 those keys are never applied, and "format-ar"
    // specifically kills the module outright ("argument not found"), which
    // also makes this work for any layout added later without new keys.
    "format": "\uf11c  {shortDescription}"
  },

  // Workspace buttons. Not the built-in hyprland/workspaces module: its
  // click handler sends the classic `dispatch workspace N`, which this
  // Hyprland's Lua config rejects, so its buttons were dead. Each button is
  // its own module so it can have its own on-click; workspaces.sh explains.
  // "signal": 9 matches the `pkill -RTMIN+9 waybar` in workspaces.sh listen.
  "custom/ws1": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 1", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 1",
                   "signal": 9, "tooltip": false },
  "custom/ws2": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 2", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 2",
                   "signal": 9, "tooltip": false },
  "custom/ws3": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 3", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 3",
                   "signal": 9, "tooltip": false },
  "custom/ws4": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 4", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 4",
                   "signal": 9, "tooltip": false },
  "custom/ws5": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 5", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 5",
                   "signal": 9, "tooltip": false },
  "custom/ws6": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 6", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 6",
                   "signal": 9, "tooltip": false },
  "custom/ws7": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 7", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 7",
                   "signal": 9, "tooltip": false },
  "custom/ws8": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 8", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 8",
                   "signal": 9, "tooltip": false },
  "custom/ws9": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 9", "return-type": "json",
                   "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 9",
                   "signal": 9, "tooltip": false },
  "custom/ws10": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh show 10", "return-type": "json",
                    "on-click": "$HOME/.config/hypr/scripts/workspaces.sh focus 10",
                    "signal": 9, "tooltip": false },
  // Never prints, so never drawn: just keeps the listener tied to the bar.
  "custom/ws-events": { "exec": "$HOME/.config/hypr/scripts/workspaces.sh listen" },


  // Date and time together, always -- no format-alt, so there's nothing to
  // click-to-switch. Tooltip header repeats the same pair spelled out in
  // full, above the month calendar, so the tooltip reads as one revamped
  // view instead of a bare grid.
  "clock": {
    "interval": 10,
    // No padding spaces in the format string: two leading spaces and none
    // trailing pushed the text off-centre inside the island. Padding is the
    // stylesheet's job (#clock), where it stays symmetric.
    "format": "{:%a %d %b  %H:%M}",
    // {0:...} twice, not two bare {:...} -- unindexed placeholders each
    // claim the NEXT positional argument in fmt's scheme, but there's only
    // one (the current time); a second bare {:...} looks for an argument
    // that was never passed, throws, and silently blanks the whole tooltip
    // -- which is why the calendar stopped showing up. {0:...} pins both to
    // that same single argument instead.
    "tooltip-format": "<span color='#${FG0}'><b>{0:%A, %d %B %Y}</b></span>  <span color='#${YELLOW}'>{0:%H:%M}</span>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":  "<span color='#${FG0}'><b>{}</b></span>",
        "days":    "<span color='#${FG0}'>{}</span>",
        "weekdays":"<span color='#${YELLOW}'><b>{}</b></span>",
        "today":   "<span color='#${ORANGE}'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu":    { "interval": 2, "format": "  {usage}%", "tooltip": true },
  "memory": { "interval": 5, "format": "  {percentage}%",
              "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎",
                      "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-linked": "󰈀  no IP",
    "format-disconnected": "󰖪  offline",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    // nmtui in kitty, so it inherits the Gruvbox Material terminal colours.
    "on-click": "kitty --class net-tui -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯  {status}",
    "format-connected": "󰂱  {device_alias}",
    "format-disabled": "󰂲",
    // This machine has no controller; hide the module rather than show a dead icon.
    "format-no-controller": "",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚", "none": "󰂜",
      "dnd-notification": "󰂛", "dnd-none": "󰂛",
      "inhibited-notification": "󰂚", "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // Coffee-cup keep-awake toggle, click-only (no keybind). "signal": 8
  // matches caffeine.sh's `pkill -RTMIN+8 waybar`, so the icon updates the
  // instant either trigger fires instead of waiting for the next interval.
  "custom/caffeine": {
    "format": "",
    "tooltip": true,
    "return-type": "json",
    "exec": "$HOME/.config/hypr/scripts/caffeine.sh status",
    "on-click": "$HOME/.config/hypr/scripts/caffeine.sh toggle",
    "interval": 30,
    "signal": 8
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "$HOME/.config/hypr/scripts/rofi-power.sh"
  }
}
