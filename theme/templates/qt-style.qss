/* GENERATED by theme/render.sh -- do not edit by hand. Edit theme/templates/.
 * Qt stylesheet loaded by qt6ct for every Qt app (Dolphin included).
 * Tabs drawn like the rest of the desktop instead of Fusion's raised boxes:
 * a flat bg1 strip, the current tab lifted to bg0 with an accent underline
 * (GTK notebook tabs do the same), and a quiet close "x" that only turns red
 * on hover -- Breeze's always-red close box read as an alert.
 * url() paths must be absolute (QSS resolves relative ones against the
 * app's cwd), hence ${HOME}.
 */

QTabBar {
  background: #${BG1};
  border: none;
}
QTabBar::tab {
  background: #${BG1};
  color: #${GREY2};
  border: none;
  border-bottom: 2px solid transparent;
  padding: 6px 10px 6px 12px;
  margin: 0;
  min-width: 60px;
}
QTabBar::tab:hover:!selected {
  background: #${BG3};
  color: #${FG0};
}
QTabBar::tab:selected {
  background: #${BG0};
  color: #${FG0};
  border-bottom: 2px solid #${ACCENT};
}
QTabBar::close-button {
  image: url(${HOME}/.config/qt6ct/qss/tab-close.svg);
  subcontrol-position: right;
  margin-left: 4px;
}
QTabBar::close-button:hover {
  image: url(${HOME}/.config/qt6ct/qss/tab-close-hover.svg);
}
QTabBar QToolButton {
  background: #${BG1};
  border: none;
  color: #${FG0};
}
QTabBar QToolButton:hover { background: #${BG3}; }
QTabWidget::pane { border: none; }
