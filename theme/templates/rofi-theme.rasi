/* GENERATED by theme/render.sh -- do not edit by hand. Edit theme/templates/. */
/* Theme: ${THEME_LABEL}, accent #${ACCENT}
 *
 * Design rules, matching waybar's:
 *   1. Colour means state. The accent marks the selected row and the prompt;
 *      everything else is a neutral tone.
 *   2. Radius scale 12 / 8 / 6, outer to inner -- nested corners must shrink
 *      or the inner ones look wrong against the outer curve.
 *   3. Spacing on a 2px scale, kept tight -- these menus should be compact.
 *   4. The selected row is an accent outline + accent text, not a fill: row
 *      icons are images rofi can't recolour, and they vanish on a solid
 *      accent pill.
 */

/* Icon set matching the theme's mode (Gruvbox-Plus-Dark / -Light). Lives
   here rather than in the hand-written config.rasi because it changes with
   the theme. */
configuration {
    icon-theme: "${ICON_THEME}";
}

* {
    bg0:      #${BG0};
    bg1:      #${BG1};
    bg2:      #${BG2};
    bg3:      #${BG3};
    bg5:      #${BG5};
    fg0:      #${FG0};
    fg1:      #${FG1};
    grey1:    #${GREY1};
    grey2:    #${GREY2};
    red:      #${RED};
    orange:   #${ORANGE};
    accent:   #${ACCENT};

    background-color: transparent;
    text-color:       @fg1;
    font:             "Roboto, JetBrainsMono Nerd Font Propo 10";
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     @accent;
    border-radius:    10px;
    width:            32%;
    padding:          6px;
}

/* rofi puts `message` under the inputbar by default; the order is set
   explicitly to push the footer to the bottom of the window. */
mainbox {
    children: [ inputbar, listview, message ];
    spacing:  6px;
}

/* No prompt widget -- a pretext like "Windows" or "Screenshot" before the
   filter is chrome the eye has to skip past. The entry's own placeholder
   already says "type to filter"; that is enough context. */
inputbar {
    background-color: @bg1;
    border-radius:    7px;
    padding:          5px 8px;
    children:         [ entry ];
}

entry {
    placeholder:       "Filter";
    placeholder-color: @grey1;
    text-color:        @fg0;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:        10;
    /* Off by default: most menus are short. Long ones (the cheat sheet) turn
       it on with -theme-str. */
    scrollbar:    false;
    fixed-height: false;
    spacing:      1px;
}

/* Styled here rather than at the call site so the colours still come from the
   palette instead of being hardcoded into a -theme-str. */
scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @bg5;
    background-color: @bg1;
    border-radius:    4px;
}

element {
    padding:       4px 8px;
    border:        1px;
    border-color:  transparent;   /* reserves the selection outline's 1px */
    border-radius: 5px;
    cursor:        pointer;
    text-color:    @fg1;
}

/* Hover is a hint, not a commitment: background only, no accent edge. */
element normal urgent  { text-color: @red; }
element normal active  { text-color: @orange; }

element alternate normal { background-color: transparent; }

/* Selection: an accent outline + accent text on the normal background, not a
   solid fill. Icons are images rofi cannot recolour, and the icon theme's
   cream glyphs vanished on a solid green pill. */
element selected {
    background-color: transparent;
    border-color:     @accent;
    text-color:       @accent;
}

element selected urgent { border-color: @red;    text-color: @red; }
element selected active { border-color: @orange; text-color: @orange; }

element-text { background-color: inherit; text-color: inherit; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 16px; padding: 0 8px 0 0; }

/* Fuzzy-match highlight: colour-as-accent on a normal row. On a selected row
   the text already IS the accent, so colour can't do double duty -- underline
   carries it instead. */
element-text highlight                  { text-color: @accent; }
element selected element-text highlight { text-color: @accent; underline: true; }

/* Footer: a quiet strip of key hints. Deliberately the lowest-contrast thing
   in the window -- it is reference, not content. */
message {
    background-color: @bg1;
    border-radius:    7px;
    padding:          5px 8px;
}

textbox {
    text-color: @grey2;
    markup:     true;
}
