/* GENERATED by theme/render.sh from theme/palette.sh -- do not edit by hand. */
/* Gruvbox Material (dark / medium / material) */

* {
    bg0:      #${BG0};
    bg1:      #${BG1};
    bg3:      #${BG3};
    fg0:      #${FG0};
    fg1:      #${FG1};
    grey1:    #${GREY1};
    red:      #${RED};
    orange:   #${ORANGE};
    yellow:   #${YELLOW};

    background-color: transparent;
    text-color:       @fg0;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg0;
    border:           2px;
    border-color:     @bg3;
    border-radius:    10px;   /* matches decoration.rounding in hyprland.lua */
    width:            46%;
    padding:          10px;
}

/* Footer: rofi puts `message` under the inputbar by default, so the order is
   set explicitly to push it to the bottom of the window. */
mainbox {
    children: [ inputbar, listview, message ];
    spacing:  8px;
}

inputbar {
    background-color: @bg1;
    border-radius:    8px;
    padding:          8px 10px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt { text-color: @yellow; }
entry  { placeholder: "Type to filter"; placeholder-color: @grey1; cursor: text; }

listview {
    lines:        10;
    scrollbar:    false;
    fixed-height: false;
    spacing:      2px;
}

element {
    padding:       7px 9px;
    border-radius: 8px;
    cursor:        pointer;
}

element selected {
    background-color: @yellow;
    text-color:       @bg0;
}

element-text  { background-color: inherit; text-color: inherit; vertical-align: 0.5; }
element-icon  { background-color: transparent; size: 22px; padding: 0 8px 0 0; }

/* Fuzzy-match highlight, readable on both normal and selected rows. */
element-text highlight { text-color: @orange; }
element selected element-text highlight { text-color: @bg0; underline: true; }

message {
    background-color: @bg1;
    border-radius:    8px;
    padding:          7px 10px;
}

textbox {
    text-color: @grey1;
    markup:     true;
}
