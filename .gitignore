*.bak
*.swp

# Wallpaper images: the path lives in-repo (hyprpaper.conf), but the
# binaries themselves don't belong in git history.
/wallpapers/*
!/wallpapers/.gitkeep

# Rendered by theme/render.sh for the active theme -- they change on every
# theme switch, so they are build output, not source. Keep this list in step
# with RENDER_TABLE / RENDER_WITH_HOME_TABLE / render_gtk_theme in render.sh.
/config/.config/gtk-4.0/gtk.css
/config/.config/gtk-4.0/settings.ini
/config/.config/hypr/colors.lua
/config/.config/hypr/hyprlock.conf
/config/.config/kdeglobals
/config/.config/kitty/colors.conf
/config/.config/qt6ct/colors/current-theme.conf
/config/.config/qt6ct/qss/current-theme.qss
/config/.config/qt6ct/qss/tab-close-hover.svg
/config/.config/qt6ct/qss/tab-close.svg
/config/.config/qt6ct/qt6ct.conf
/config/.config/rofi/current-theme.rasi
/config/.config/swaync/style.css
/config/.config/swayosd/style.css
/config/.config/waybar/config.jsonc
/config/.config/waybar/style.css
/config/.config/yazi/theme.toml
/config/.local/share/color-schemes/CurrentTheme.colors
/config/.local/share/themes/Current-Theme/gtk-3.0/gtk.css
/config/.local/share/themes/Current-Theme/gtk-4.0/gtk.css
/system/sddm/theme/theme.conf
