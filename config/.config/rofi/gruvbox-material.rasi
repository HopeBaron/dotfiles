/* GENERATED by theme/render.sh from theme/palette.sh -- do not edit by hand. */
/* Gruvbox Material (dark / medium / material)
 *
 * Design rules, matching waybar's:
 *   1. Colour means state. The accent marks the selected row and the prompt;
 *      everything else is a neutral tone.
 *   2. Radius scale 12 / 8 / 6, outer to inner -- nested corners must shrink
 *      or the inner ones look wrong against the outer curve.
 *   3. Spacing on a 4px scale.
 *   4. The selected row is marked by an accent EDGE plus a raised background,
 *      not a saturated fill. A full-bleed fill fights the text it carries.
 */

* {
    bg0:      #282828;
    bg1:      #32302f;
    bg2:      #32302f;
    bg3:      #45403d;
    bg5:      #5a524c;
    fg0:      #d4be98;
    fg1:      #ddc7a1;
    grey1:    #928374;
    grey2:    #a89984;
    red:      #ea6962;
    orange:   #e78a4e;
    yellow:   #d8a657;

    background-color: transparent;
    text-color:       @fg1;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     @bg5;
    border-radius:    12px;
    width:            46%;
    padding:          12px;
}

/* rofi puts `message` under the inputbar by default; the order is set
   explicitly to push the footer to the bottom of the window. */
mainbox {
    children: [ inputbar, listview, message ];
    spacing:  12px;
}

inputbar {
    background-color: @bg1;
    border-radius:    8px;
    padding:          8px 12px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

/* The prompt is the one piece of chrome that carries the accent, so the eye
   lands on "what am I picking" before the list. */
prompt {
    text-color:  @yellow;
    font:        "JetBrainsMono Nerd Font Bold 12";
    vertical-align: 0.5;
}

entry {
    placeholder:       "Type to filter";
    placeholder-color: @grey1;
    text-color:        @fg0;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:        10;
    /* Off by default: most menus are short. Long ones (the cheat sheet) turn
       it on with -theme-str. */
    scrollbar:    false;
    fixed-height: false;
    spacing:      4px;
}

/* Styled here rather than at the call site so the colours still come from the
   palette instead of being hardcoded into a -theme-str. */
scrollbar {
    width:            4px;
    handle-width:     4px;
    handle-color:     @bg5;
    background-color: @bg1;
    border-radius:    4px;
}

element {
    padding:       8px 10px;
    border-radius: 6px;
    cursor:        pointer;
    text-color:    @fg1;
}

/* Hover is a hint, not a commitment: background only, no accent edge. */
element normal urgent  { text-color: @red; }
element normal active  { text-color: @orange; }

element alternate normal { background-color: transparent; }

/* Selection: raised surface + a 3px accent edge. Readable, and it does not
   invert the row's text the way a saturated fill does. */
element selected {
    background-color: @bg3;
    text-color:       @fg0;
    border:           0px 0px 0px 3px;
    border-color:     @yellow;
    border-radius:    6px;
}

element selected urgent { border-color: @red; }
element selected active { border-color: @orange; }

element-text { background-color: inherit; text-color: inherit; vertical-align: 0.5; }
element-icon { background-color: transparent; size: 20px; padding: 0 10px 0 0; }

/* Fuzzy-match highlight, readable both on a normal row and a selected one. */
element-text highlight                  { text-color: @yellow; }
element selected element-text highlight { text-color: @yellow; underline: true; }

/* Footer: a quiet strip of key hints. Deliberately the lowest-contrast thing
   in the window -- it is reference, not content. */
message {
    background-color: @bg1;
    border-radius:    8px;
    padding:          8px 12px;
}

textbox {
    text-color: @grey2;
    markup:     true;
}
