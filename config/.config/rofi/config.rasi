/* rofi -- hand-written. Colours live in current-theme.rasi (generated;
   see theme/render.sh -- that fixed filename holds whichever theme is
   actually active, GruvMoon/mono-light/anything else included, not just
   Gruvbox Material variants). Per-menu flags come from the scripts in
   ~/.config/hypr/scripts/, so nothing here pins a mode. */

configuration {
    modes:                 "drun,run,window";
    show-icons:            true;
    drun-display-format:   "{name}";
    display-drun:          "Apps";
    display-window:        "Windows";
    matching:              "fuzzy";
    sort:                  true;
    case-sensitive:        false;
    hover-select:          true;
    me-select-entry:       "MousePrimary";
    me-accept-entry:       "MouseDPrimary";
    /* No kb-custom-N here on purpose: rofi's custom bindings are one shared
       keymap per PROCESS, not per script, so pinning one here would reserve
       it for every menu, not just the one that actually uses it -- which is
       exactly what broke rofi-theme-picker.sh's own Alt+a until this was
       caught. Each script instead passes its own -kb-custom-N on its own
       `rofi` call (rofi-clipboard.sh, rofi-screenshot.sh, rofi-windows.sh,
       rofi-theme-picker.sh), scoped to just that invocation. */
}

@theme "current-theme"
