/* rofi layout for menus that preview images: the wallpaper picker and the
 * clipboard. Hand-written; colours come from the rendered main theme, this
 * only rearranges it.
 *
 *   rows     icon (if the row has one), then text -- the row's own script
 *            bakes its number and marker into that text, e.g. "3  ● name"
 *            (same as the window switcher), rather than using rofi's
 *            element-index: that widget is the Alt+1..0 keybind-shortcut
 *            indicator (see `man rofi-theme`), not a row counter -- it only
 *            ever labels the first 10 rows, going blank on every row after
 *            that, however long the list actually is.
 *   right    a large copy of the highlighted row's icon, if it has one
 *            (rofi's own icon-current-entry). A row with no icon (clipboard
 *            text) leaves it empty -- explicit `width`, not just `size`,
 *            keeps the pane itself from collapsing to nothing in that case,
 *            so the border-left still reads as "there is a preview column
 *            here", just with nothing to show right now. Background stays
 *            transparent so an empty pane doesn't paint a visible block.
 *
 * Used as:  rofi -dmenu -theme preview ...
 */
@import "gruvbox-material"

/* The list stays compact (small per-row icon, ~650px worth of list); the
 * preview column is full-size, so the window is wider than a plain list
 * menu to fit both. */
window {
    width: 900px;
}

mainbox {
    children: [ inputbar, body, message ];
}

body {
    orientation: horizontal;
    spacing:     6px;
    children:    [ listview, icon-current-entry ];
}

listview {
    lines: 10;
}

element-icon {
    size:    20px;
    padding: 0 8px 0 0;
}

icon-current-entry {
    expand:           false;
    width:            340px;   /* keeps the column even with no icon to show */
    size:             340px;
    background-color: transparent;
    border:           0px 0px 0px 1px;
    border-color:     @bg3;
}
