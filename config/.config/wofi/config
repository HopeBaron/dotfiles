# wofi -- hand-written. Colours live in style.css (generated; see theme/render.sh).
# Per-mode flags (--show, --prompt, --width, --height) come from the scripts in
# ~/.config/hypr/scripts/, so nothing here pins a mode.

allow_images=true
image_size=26
insensitive=true
no_actions=true
hide_scroll=true
print_command=false
layer=overlay
term=kitty
key_expand=Tab
