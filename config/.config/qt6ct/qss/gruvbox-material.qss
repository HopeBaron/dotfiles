/* GENERATED by theme/render.sh from theme/palette.sh -- do not edit by hand.
 * Qt stylesheet loaded by qt6ct for every Qt app (Dolphin included).
 * Tabs drawn like the rest of the desktop instead of Fusion's raised boxes:
 * a flat bg1 strip, the current tab lifted to bg0 with a green underline
 * (GTK notebook tabs do the same), and a quiet close "x" that only turns red
 * on hover -- Breeze's always-red close box read as an alert.
 * url() paths must be absolute (QSS resolves relative ones against the
 * app's cwd), hence /home/moon.
 */

QTabBar {
  background: #32302f;
  border: none;
}
QTabBar::tab {
  background: #32302f;
  color: #a89984;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 6px 10px 6px 12px;
  margin: 0;
  min-width: 60px;
}
QTabBar::tab:hover:!selected {
  background: #45403d;
  color: #d4be98;
}
QTabBar::tab:selected {
  background: #282828;
  color: #d4be98;
  border-bottom: 2px solid #a9b665;
}
QTabBar::close-button {
  image: url(/home/moon/.config/qt6ct/qss/tab-close.svg);
  subcontrol-position: right;
  margin-left: 4px;
}
QTabBar::close-button:hover {
  image: url(/home/moon/.config/qt6ct/qss/tab-close-hover.svg);
}
QTabBar QToolButton {
  background: #32302f;
  border: none;
  color: #d4be98;
}
QTabBar QToolButton:hover { background: #45403d; }
QTabWidget::pane { border: none; }
