#!/usr/bin/env bash
# Switch the desktop's colour theme and accent, and apply it everywhere.
#
#   mars-theme list                     theme ids, one per line ("id<TAB>label")
#   mars-theme current                  the saved theme and accent
#   mars-theme set <theme-id>           switch theme
#   mars-theme accent <name|#hex|reset> [theme-id ...]
#                                        set (or reset to default) the accent of
#                                        the given themes, or the current one if
#                                        none given -- name is red orange yellow
#                                        green aqua blue purple, or any #rrggbb
#   mars-theme apply                    re-render the saved choice and push it
#                                        into running apps (install.sh uses this)
#   mars-theme export <theme-id> [accent] [out.zip]
#                                        render a theme WITHOUT switching to it
#                                        (the live config is untouched) and zip
#                                        the result -- e.g. to hand a theme's
#                                        generated CSS/QSS/conf to someone
#                                        else. accent defaults to that theme's
#                                        own remembered accent, or the overall
#                                        default; out.zip defaults to
#                                        ./<theme-id>.zip
#
# Current choice is saved in ~/.local/state/mars/theme.env. A theme you have
# explicitly given its own accent (or mars-wallpaper its own wallpaper)
# remembers it from then on in ~/.local/state/mars/themes/<id>.env -- switching
# to it always restores that accent/wallpaper. An untouched theme has no such
# file and just carries forward whatever is already active. See theme/lib.sh.
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../theme/lib.sh
. "$REPO/theme/lib.sh"

usage() {
  sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

notify() {
  command -v notify-send >/dev/null && notify-send -a theme "$@" || true
}

running() { pgrep -x "$1" >/dev/null; }

# ---- pushing a freshly rendered theme into running apps ----------------------
# Each step is independent and silent when its app isn't running, so this is
# safe from a TTY, from install.sh, or mid-session.

reload_hyprland() {
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl reload >/dev/null || true
}

reload_waybar()  { running waybar && pkill -SIGUSR2 -x waybar || true; }  # re-reads config + CSS
reload_swaync()  { running swaync && swaync-client --reload-css >/dev/null || true; }
reload_kitty()   { running kitty  && pkill -SIGUSR1 -x kitty  || true; }  # re-reads kitty.conf

# swayosd only reads its stylesheet at start-up.
reload_swayosd() {
  running swayosd-server || return 0
  pkill -x swayosd-server
  setsid swayosd-server >/dev/null 2>&1 &
}

# GTK3 apps follow these keys live. GTK only re-reads a theme whose NAME
# changed, so bounce through Adwaita to make it reload the re-rendered CSS.
apply_gsettings() {
  command -v gsettings >/dev/null || return 0
  local schema=org.gnome.desktop.interface
  gsettings set $schema color-scheme "$COLOR_SCHEME"
  gsettings set $schema icon-theme "$ICON_THEME"
  gsettings set $schema font-name 'Roboto 10'
  gsettings set $schema monospace-font-name 'JetBrainsMono Nerd Font 10'
  gsettings set $schema gtk-theme 'Adwaita'
  gsettings set $schema gtk-theme 'Current-Theme'
}

# KDE apps (Dolphin) re-read their colour scheme on this broadcast.
notify_kde_apps() {
  command -v dbus-send >/dev/null || return 0
  dbus-send --session --type=signal /KGlobalSettings \
    org.kde.KGlobalSettings.notifyChange int32:0 int32:0 2>/dev/null || true
}

# Running Neovim instances re-read the theme state (see nvim's mars/theme.lua).
reload_neovim() {
  command -v nvim >/dev/null || return 0
  local socket
  for socket in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0; do
    [[ -S "$socket" ]] || continue
    nvim --server "$socket" --remote-send '<Cmd>lua require("mars.theme").apply()<CR>' \
      >/dev/null 2>&1 || true
  done
}

apply() {
  "$REPO/theme/render.sh" >/dev/null
  theme_activate   # the rendered values, for the steps below
  reload_hyprland
  reload_waybar
  reload_swaync
  reload_kitty
  reload_swayosd
  apply_gsettings
  notify_kde_apps
  reload_neovim
}

# ---- commands ----------------------------------------------------------------

cmd_list() {
  local id
  while read -r id; do
    printf '%s\t%s\n' "$id" "$(theme_label "$id")"
  done < <(theme_list)
}

cmd_current() {
  state_load
  printf 'theme\t%s\t%s\naccent\t%s\n' "$THEME" "$(theme_label "$THEME")" "$ACCENT_SPEC"
}

cmd_set() {
  local id=${1:?usage: mars-theme set <theme-id>}
  theme_exists "$id" || { echo "unknown theme: $id (see: mars-theme list)" >&2; exit 1; }

  state_load   # ACCENT_SPEC here is the outgoing theme's accent -- the
               # carry-forward value if $id has never been given its own

  local accent
  accent=$(theme_get_accent "$id")
  [[ -n "$accent" ]] || accent=$ACCENT_SPEC

  state_save "$id" "$accent"
  apply

  # A wallpaper override applies on top of whatever apply() already did (or
  # didn't) for the wallpaper; with none, this theme just keeps whatever is
  # currently showing.
  local wallpaper
  wallpaper=$(theme_get_wallpaper "$id")
  [[ -n "$wallpaper" ]] && "$REPO/bin/mars-wallpaper" apply "$wallpaper" >/dev/null 2>&1

  notify "Theme: $(theme_label "$id")" "Restart open Qt/KDE and GTK4 apps to pick it up everywhere"
}

# Sets (or resets) the accent for one or more themes. With no theme-id, only
# the current theme is affected -- the ordinary single-theme case. The
# current live accent only changes if the current theme is among the targets.
cmd_accent() {
  local spec_arg=${1:?usage: mars-theme accent <name|#rrggbb|reset> [theme-id ...]}
  shift
  local targets=("$@") id

  state_load   # THEME = current theme, for the "is it among the targets?" check
  (( ${#targets[@]} == 0 )) && targets=("$THEME")

  local spec applied=0
  if [[ "$spec_arg" == reset ]]; then
    for id in "${targets[@]}"; do theme_reset_accent "$id"; done
    spec=$MARS_DEFAULT_ACCENT
  else
    spec=$(accent_normalize "$spec_arg") || {
      echo "not an accent: $spec_arg (use ${MARS_ACCENT_NAMES[*]}, #rrggbb, or reset)" >&2
      exit 1
    }
    for id in "${targets[@]}"; do theme_set_accent "$id" "$spec"; done
  fi

  for id in "${targets[@]}"; do
    if [[ "$id" == "$THEME" ]]; then
      state_save "$THEME" "$spec"
      apply
      applied=1
      break
    fi
  done

  if (( ${#targets[@]} > 1 )); then
    notify "Accent: $spec" "Applied to ${#targets[@]} themes"
  elif (( applied )); then
    notify "Accent: $spec"
  else
    notify "Accent: $spec" "Saved for ${targets[0]}; switch to it to see it"
  fi
}

cmd_export() {
  local id=${1:?usage: mars-theme export <theme-id> [accent] [out.zip]}
  theme_exists "$id" || { echo "unknown theme: $id (see: mars-theme list)" >&2; exit 1; }

  local accent_arg=${2:-} out=${3:-"./$id.zip"}
  out=$(realpath -m "$out")   # absolute, before we cd into the scratch dir below
  local accent
  if [[ -n "$accent_arg" ]]; then
    accent=$(accent_normalize "$accent_arg") || {
      echo "not an accent: $accent_arg (use ${MARS_ACCENT_NAMES[*]}, or #rrggbb)" >&2
      exit 1
    }
  else
    accent=$(theme_get_accent "$id")
    [[ -n "$accent" ]] || accent=$MARS_DEFAULT_ACCENT
  fi

  theme_load "$id"
  theme_derive "$accent"

  local scratch
  scratch=$(mktemp -d)
  # EXIT, not RETURN: a RETURN trap would also fire the moment the `.
  # render.sh` line below finishes sourcing, deleting $scratch before
  # render_all ever runs.
  # shellcheck disable=SC2064
  trap "rm -rf '$scratch'" EXIT

  export MARS_RENDER_ROOT=$scratch
  # shellcheck source=../theme/render.sh
  . "$REPO/theme/render.sh"
  render_all >/dev/null
  unset MARS_RENDER_ROOT

  command -v bsdtar >/dev/null || { echo "bsdtar not found -- can't zip" >&2; exit 1; }
  ( cd "$scratch" && bsdtar -a -cf "$out" -- * )

  echo "Exported $(theme_label "$id"), accent $accent (#$ACCENT) -> $out"
}

main() {
  case "${1:-}" in
    list)    cmd_list ;;
    current) cmd_current ;;
    set)     cmd_set "${2:-}" ;;
    accent)  cmd_accent "${@:2}" ;;
    export)  cmd_export "${2:-}" "${3:-}" "${4:-}" ;;
    apply)   apply ;;
    -h|--help|help) usage ;;
    *) usage 2 ;;
  esac
}

main "$@"
