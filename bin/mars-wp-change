#!/usr/bin/env bash
# Set the Hyprland wallpaper: applies it live via hyprpaper's IPC and
# persists it by rewriting hyprpaper.conf's `path =` line.
#
#   mars-wp-change <filename>   -- a file in this repo's wallpapers/ dir
#   mars-wp-change <path>       -- any image path
#   mars-wp-change              -- list available wallpapers and exit
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
wallpapers_dir="$repo/wallpapers"
hyprpaper_conf="$repo/config/.config/hypr/hyprpaper.conf"

if [ $# -eq 0 ]; then
  echo "Usage: mars-wp-change <filename-in-wallpapers-dir|path>"
  echo
  echo "Available in $wallpapers_dir:"
  ls -1 "$wallpapers_dir" 2>/dev/null | grep -Ev '^\.' || echo "  (none)"
  exit 0
fi

arg=$1
if [ -f "$arg" ]; then
  picked=$(readlink -f "$arg")
elif [ -f "$wallpapers_dir/$arg" ]; then
  picked="$wallpapers_dir/$arg"
else
  echo "Not found: $arg" >&2
  exit 1
fi

hyprctl hyprpaper wallpaper ",$picked,cover"

# Persist with a repo-relative ~ path when the image lives inside
# wallpapers/, matching the convention already used in hyprpaper.conf;
# otherwise fall back to the resolved absolute path as-is.
case "$picked" in
  "$wallpapers_dir"/*)
    persist_path="~/personal/projects/mars/dotfiles/wallpapers/${picked#"$wallpapers_dir"/}"
    ;;
  *) persist_path="$picked" ;;
esac
sed -i "s|^    path = .*|    path = $persist_path|" "$hyprpaper_conf"

echo "Wallpaper set: $picked"
