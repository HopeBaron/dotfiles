#!/usr/bin/env bash
# Set the desktop wallpaper: applies it live through hyprpaper and saves it
# for the next login.
#
#   mars-wallpaper list                 wallpapers in the repo's wallpapers/ dir
#   mars-wallpaper current              path of the currently active wallpaper
#   mars-wallpaper set <name|path> [theme-id ...]
#                                        set the wallpaper for the given
#                                        themes, or the current one if none
#                                        given -- name is a file in
#                                        wallpapers/, or any image path
#   mars-wallpaper apply <path>         make <path> live right now, without
#                                        saving it as any theme's own choice
#                                        (mars-theme uses this when switching
#                                        to a theme that already has one)
#
# The live wallpaper lives in ~/.local/state/mars/wallpaper.conf, which
# config/.config/hypr/hyprpaper.conf sources -- so switching never edits a
# tracked file. A theme you have explicitly given a wallpaper remembers it in
# ~/.local/state/mars/themes/<id>.env (see theme/lib.sh) and restores it
# whenever you switch back; an untouched theme just keeps whatever is
# already showing.
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../theme/lib.sh
. "$REPO/theme/lib.sh"   # also brings in lib/mars.sh (MARS_WALLPAPER_DIR, ...)

readonly STATE_FILE="$MARS_STATE_DIR/wallpaper.conf"
readonly IMAGE_PATTERN='.*\.(jpe?g|png|webp)$'

usage() {
  sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

cmd_list() {
  find "$MARS_WALLPAPER_DIR" -maxdepth 1 -type f -regextype posix-extended -iregex "$IMAGE_PATTERN" -printf '%f\n' | sort
}

cmd_current() {
  [[ -r "$STATE_FILE" ]] || return 0
  sed -n 's/^[[:space:]]*path[[:space:]]*=[[:space:]]*//p' "$STATE_FILE" | head -n1
}

# name in wallpapers/, or an existing path -> absolute path
resolve() {
  if [[ -f "$MARS_WALLPAPER_DIR/$1" ]]; then
    echo "$MARS_WALLPAPER_DIR/$1"
  elif [[ -f "$1" ]]; then
    readlink -f "$1"
  else
    echo "no such wallpaper: $1 (see: mars-wallpaper list)" >&2
    return 1
  fi
}

# Makes <path> the live wallpaper: writes the state file hyprpaper.conf
# sources, and nudges a running hyprpaper over IPC. Does not touch any
# theme's own remembered choice -- see cmd_set for that.
cmd_apply() {
  local path=${1:?usage: mars-wallpaper apply <path>}
  mkdir -p "$MARS_STATE_DIR"
  cat > "$STATE_FILE" <<CONF
# Written by mars-wallpaper; sourced by ~/.config/hypr/hyprpaper.conf.
wallpaper {
    monitor =
    path = $path
    fit_mode = cover
}
CONF
  if pgrep -x hyprpaper >/dev/null; then
    hyprctl hyprpaper wallpaper ",$path,cover" >/dev/null
  elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    # Not running (e.g. it exited at login before any wallpaper was set):
    # start it, and it picks up the state file just written.
    setsid -f hyprpaper >/dev/null 2>&1
  fi
}

# Sets the wallpaper for one or more themes. With no theme-id, only the
# current theme is affected -- the ordinary single-theme case. The live
# wallpaper only changes if the current theme is among the targets.
cmd_set() {
  local path
  path=$(resolve "${1:?usage: mars-wallpaper set <name|path> [theme-id ...]}")
  shift
  local targets=("$@") id

  state_load   # THEME = current theme, for the "is it among the targets?" check
  (( ${#targets[@]} == 0 )) && targets=("$THEME")

  for id in "${targets[@]}"; do theme_set_wallpaper "$id" "$path"; done

  local applied=0
  for id in "${targets[@]}"; do
    if [[ "$id" == "$THEME" ]]; then
      cmd_apply "$path"
      applied=1
      break
    fi
  done

  if (( ${#targets[@]} > 1 )); then
    echo "Wallpaper: $path (applied to ${#targets[@]} themes)"
  elif (( applied )); then
    echo "Wallpaper: $path"
  else
    echo "Wallpaper: $path (saved for ${targets[0]}; switch to it to see it)"
  fi
}

case "${1:-}" in
  list)    cmd_list ;;
  current) cmd_current ;;
  set)     shift; cmd_set "$@" ;;
  apply)   cmd_apply "${2:-}" ;;
  -h|--help|help) usage ;;
  *) usage 2 ;;
esac
